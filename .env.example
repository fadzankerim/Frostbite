# Kopirajte u .env i popunite. Datoteka .env se NE stavlja u git.
#
# Tajni ključ (64 nasumična znaka), npr.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

# Host(ovi) preko kojih se pristupa aplikaciji, odvojeni zarezom (npr. localhost ili 10.0.143.199)
DJANGO_ALLOWED_HOSTS=localhost

# PostgreSQL
DB_NAME=frostbite
DB_USER=frostbite
DB_PASSWORD=

# Ime za samopotpisani TLS certifikat (obično isto kao DJANGO_ALLOWED_HOSTS)
TLS_CN=localhost
